{
  "name": "@synra/plugin-system",
  "version": "0.0.6",
  "description": "Shared plugin system contracts and utilities for Synra.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser/index.ts",
    "./node": "./src/node.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./browser": "./dist/browser.mjs",
      "./node": "./dist/node.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@synra/protocol": "workspace:*",
    "fflate": "catalog:build",
    "pathe": "catalog:build"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "typescript": "catalog:types",
    "vite-plus": "catalog:vite"
  }
}
