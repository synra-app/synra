{
  "name": "@synra/bridge-schema",
  "version": "0.0.1",
  "description": "Canonical IPC bridge wire schema for Synra (MethodPayloadMap, MethodResultMap, BRIDGE_METHODS, request/response envelopes, validators). Pure types — no runtime code. Use this when you need the wire contract without pulling in the full @synra/capacitor-electron runtime stack.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test --passWithNoTests",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@synra/plugin-sdk": "workspace:*",
    "@synra/plugin-system": "workspace:*",
    "@synra/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "@typescript/native-preview": "catalog:types",
    "typescript": "catalog:types",
    "vite-plus": "catalog:vite"
  }
}
